{{velocity}}
## WikiDB skin: the DSFR's <head> tags (favicons, manifest, theme colour), from the DSFR getting-started guide.
## Rendered by Flamingo's meta.vm through the org.xwiki.platform.html.head extension point, after XWiki's own favicon
## links, so browsers keep the DSFR ones. Files come from the offline webjar, which guests can load too.
#set ($dsfr = 'fr.finances.budget.wikidb:wikidb-dsfr')
{{html clean="false"}}
<meta name="format-detection" content="telephone=no,date=no,address=no,email=no,url=no" />
<meta name="theme-color" content="#000091" />
<link rel="apple-touch-icon" href="$services.webjars.url($dsfr, 'dist/favicon/apple-touch-icon.png')" />
<link rel="icon" href="$services.webjars.url($dsfr, 'dist/favicon/favicon.svg')" type="image/svg+xml" />
<link rel="shortcut icon" href="$services.webjars.url($dsfr, 'dist/favicon/favicon.ico')" type="image/x-icon" />
<link rel="manifest" href="$services.webjars.url($dsfr, 'dist/favicon/manifest.webmanifest')" crossorigin="use-credentials" />
{{/html}}
{{/velocity}}
