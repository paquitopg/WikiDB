    'component/footer/footer', 'component/alert/alert', 'component/breadcrumb/breadcrumb',
    'component/form/form', 'component/input/input', 'component/table/table', 'component/tag/tag'])
  $xwiki.linkx.use($services.webjars.url($dsfr, "dist/${css}.min.css"), {'type': 'text/css', 'rel': 'stylesheet'})
#end
$xwiki.linkx.use($services.webjars.url($dsfr, 'wikidb/dsfr-bridge.css'), {'type': 'text/css', 'rel': 'stylesheet'})
