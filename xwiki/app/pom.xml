<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>fr.finances.budget.wikidb</groupId>
    <artifactId>wikidb-parent</artifactId>
    <version>${revision}</version>
  </parent>
  <artifactId>wikidb-app</artifactId>
  <packaging>xar</packaging>
  <name>WikiDB - Applications</name>
  <description>Measure sheets, procedures, glossary, who-does-what, wiki-level rights and the DSFR skin</description>
  <build>
    <plugins>
      <plugin>
        <!-- The skin's templates are kept as plain files and inserted into WikiDB.Code.Skin at build time. -->
        <groupId>org.xwiki.commons</groupId>
        <artifactId>xwiki-commons-tool-xar-plugin</artifactId>
        <configuration>
          <transformations>
            <transformation>
              <file>WikiDB/Code/Skin.xml</file>
              <xpath>/xwikidoc/object[className='XWiki.XWikiSkins']/property/footer.vm</xpath>
              <action>INSERT_TEXT</action>
              <content>${project.basedir}/src/main/skin/footer.vm</content>
            </transformation>
            <transformation>
              <file>WikiDB/Code/Skin.xml</file>
              <xpath>/xwikidoc/attachment[filename='wikidb_dsfr.vm']</xpath>
              <action>INSERT_ATTACHMENT_CONTENT</action>
              <content>${project.basedir}/src/main/skin/wikidb_dsfr.vm</content>
            </transformation>
            <transformation>
              <file>WikiDB/Code/Skin.xml</file>
              <xpath>/xwikidoc/attachment[filename='menus_view.vm']</xpath>
              <action>INSERT_ATTACHMENT_CONTENT</action>
              <content>${project.basedir}/src/main/skin/menus_view.vm</content>
            </transformation>
          </transformations>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
