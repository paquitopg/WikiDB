# WikiDB base image: official XWiki 17.10 LTS + bundled offline extensions + WikiDB configuration.
# Built on the internet side (GitHub Actions) and reused unchanged on both platforms (KTD2).
# Build context: the xwiki/ directory, after `./mvnw package` produced the XIP.

# xwiki:17.10.13-postgres-tomcat
FROM xwiki@sha256:3cf4493e5cda22dcfa73e069bf894d5583a8eedd55978af81620b275007097e3

ARG WIKIDB_REVISION
RUN test -n "$WIKIDB_REVISION"

ENV WEBINF=/usr/local/tomcat/webapps/ROOT/WEB-INF

# Bundled offline extension repository, seeded into the permanent directory at startup (KTD3).
COPY xip/target/wikidb-xip-${WIKIDB_REVISION}.xip /tmp/wikidb.xip
RUN set -eux; \
  mkdir -p /usr/local/wikidb/extension-repository; \
  cd /usr/local/wikidb/extension-repository; \
  unzip -q /tmp/wikidb.xip; \
  rm -f /tmp/wikidb.xip

# Static configuration (KTD3, KTD4, KTD9, KTD12).
COPY config/ /usr/local/wikidb/config/
RUN set -eux; \
  /usr/local/wikidb/config/apply-overrides.sh "$WEBINF/xwiki.cfg" /usr/local/wikidb/config/xwiki.cfg.overrides; \
  /usr/local/wikidb/config/apply-overrides.sh "$WEBINF/xwiki.properties" /usr/local/wikidb/config/xwiki.properties.overrides; \
  printf 'distribution.defaultUI=fr.finances.budget.wikidb:wikidb-mainwiki/%s\n' "$WIKIDB_REVISION" \
    >> "$WEBINF/xwiki.properties"

COPY entrypoint-wikidb.sh /usr/local/bin/entrypoint-wikidb.sh

LABEL org.opencontainers.image.title="wikidb" \
      org.opencontainers.image.description="Direction du Budget knowledge wiki (XWiki 17.10 LTS, offline)" \
      fr.finances.budget.wikidb.revision="${WIKIDB_REVISION}"

ENTRYPOINT ["/usr/local/bin/entrypoint-wikidb.sh"]
CMD ["xwiki"]
