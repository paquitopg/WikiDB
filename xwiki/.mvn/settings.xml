<?xml version="1.0" encoding="UTF-8"?>
<!-- Repositories declared deep in third-party POMs (some long dead) make resolution hang on unreachable hosts.
     Route every repository except the ones this build declares through Maven Central, which answers fast. -->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
  <mirrors>
    <mirror>
      <id>central-for-unknown</id>
      <mirrorOf>*,!central,!xwiki-releases,!xwiki-externals,!css4j</mirrorOf>
      <url>https://repo.maven.apache.org/maven2</url>
    </mirror>
  </mirrors>
</settings>
