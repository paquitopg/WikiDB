<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.xwiki.contrib</groupId>
    <artifactId>parent-platform</artifactId>
    <version>17.10.13</version>
  </parent>
  <groupId>fr.finances.budget.wikidb</groupId>
  <artifactId>wikidb-parent</artifactId>
  <version>${revision}</version>
  <packaging>pom</packaging>
  <name>WikiDB - Parent</name>
  <description>Direction du Budget knowledge wiki: applications and offline distribution</description>
  <developers>
    <developer>
      <id>dbudget</id>
      <name>Direction du Budget</name>
    </developer>
  </developers>
  <properties>
    <!-- CI sets a unique revision per build so the distribution job upgrades the default UI -->
    <revision>1.0.0-SNAPSHOT</revision>
    <!-- Not published to XWiki's contrib infrastructure -->
    <xwiki.release.jira.skip>true</xwiki.release.jira.skip>
    <xwiki.issueManagement.jira.id>WIKIDB</xwiki.issueManagement.jira.id>
    <oidc.version>2.28.1</oidc.version>
    <!-- Diagram Application (draw.io), free edition (U12, KTD20); not supported by the XWiki core team. -->
    <diagram.version>1.3.1</diagram.version>
    <!-- DSFR (U1 of the DSFR plan): official npm release, newest one at least two weeks old when pinned.
         The sha512 is the npm registry's dist.integrity for that version, in hex. -->
    <dsfr.version>1.15.3</dsfr.version>
    <dsfr.sha512>47d0002d97352df663b72b5664c39a50838759392594167fb1996c2fc4e9299560177a94297b7fb8d621f8bd43d45878a7dd99a96c5bb4d71e6ec8a00597b9a5</dsfr.sha512>
  </properties>
  <modules>
    <module>dsfr</module>
    <module>oidc-authenticator</module>
    <module>app</module>
    <module>mainwiki</module>
    <module>xip</module>
  </modules>
  <build>
    <plugins>
      <plugin>
        <!-- Write the concrete ${revision} into the POMs: the XIP descriptors are generated from them, and an
             unresolved revision would pin the application dependency to the default version. -->
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>flatten-maven-plugin</artifactId>
        <version>1.7.3</version>
        <configuration>
          <updatePomFile>true</updatePomFile>
          <flattenMode>resolveCiFriendliesOnly</flattenMode>
        </configuration>
        <executions>
          <execution>
            <id>flatten</id>
            <phase>process-resources</phase>
            <goals><goal>flatten</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <repositories>
    <repository>
      <id>xwiki-releases</id>
      <url>https://maven.xwiki.org/releases/</url>
      <snapshots><enabled>false</enabled></snapshots>
    </repository>
    <repository>
      <id>xwiki-externals</id>
      <url>https://maven.xwiki.org/externals/</url>
      <snapshots><enabled>false</enabled></snapshots>
    </repository>
    <repository>
      <!-- css4j, a dependency of XWiki's PDF export, is only published here -->
      <id>css4j</id>
      <url>https://css4j.github.io/maven/</url>
      <snapshots><enabled>false</enabled></snapshots>
    </repository>
  </repositories>
  <pluginRepositories>
    <pluginRepository>
      <id>xwiki-releases</id>
      <url>https://maven.xwiki.org/releases/</url>
      <snapshots><enabled>false</enabled></snapshots>
    </pluginRepository>
    <pluginRepository>
      <id>xwiki-externals</id>
      <url>https://maven.xwiki.org/externals/</url>
      <snapshots><enabled>false</enabled></snapshots>
    </pluginRepository>
  </pluginRepositories>
</project>
